# ==============================================================================
# Sanjivani (Health Memory Agent) — Staging Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this template to .env.staging (NEVER commit .env.staging to Git)
# 2. Configure credentials according to your staging target (Dual-Mode supported)
# ==============================================================================

# ---- Deployment Tier ---------------------------------------------------------
NODE_ENV=staging
PORT=3001
LOG_LEVEL=info

# ---- Mode Selection ----------------------------------------------------------
# Set DEMO_MODE=true for zero-dependency standalone staging demonstration
# (uses transactional in-memory datastore with synthetic Sharma family seed).
# Set DEMO_MODE=false when connecting to a real Supabase Staging PostgreSQL project.
DEMO_MODE=true

# ---- Supabase Credentials (Required if DEMO_MODE=false) ----------------------
SUPABASE_URL=https://your-staging-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-staging-service-role-key-here
SUPABASE_ANON_KEY=your-staging-anon-key-here

# ---- Google Gemini AI / LLM Integration -------------------------------------
# Optional: Live Google Gemini API key for clinical conversational memory.
# If omitted, Sanjivani utilizes its deterministic grounded evidence retrieval fallback.
GEMINI_API_KEY=

# ---- Telephony & Phase 6 Live Test Mode --------------------------------------
# In Staging, Live Test Mode is DISABLED by default (LIVE_TEST_MODE_ENABLED=false).
# When enabled for controlled demonstration, only consenting team allowlists receive SMS.
LIVE_TEST_MODE_ENABLED=false
LIVE_TEST_TELEPHONY_PROVIDER=none
LIVE_TEST_MAX_RECIPIENTS=3
LIVE_TEST_COOLDOWN_SECONDS=30
TELEPHONY_WEBHOOK_SECRET=

# Twilio (Optional: if LIVE_TEST_TELEPHONY_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Exotel (Optional: if LIVE_TEST_TELEPHONY_PROVIDER=exotel)
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_CALLER_ID=
EXOTEL_DLT_ENTITY_ID=
EXOTEL_DLT_TEMPLATE_ID=

# ---- Phase 10: Hospital Gateway & ABDM Integrations -------------------------
# Hospital receiving desk simulation mode
HOSPITAL_INTEGRATION_MODE=simulated
HOSPITAL_GATEWAY_URL=
HOSPITAL_GATEWAY_API_KEY=

# ABDM Developer Sandbox
ABDM_ENV=sandbox
ABDM_GATEWAY_URL=https://dev.abdm.gov.in/gateway
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=

# ---- Security & CORS ---------------------------------------------------------
# The frontend origin allowed to communicate with this backend.
# In local Docker Compose staging: http://localhost:8080
# In cloud staging: https://sanjivani-staging.yourdomain.com
FRONTEND_URL=http://localhost:8080
