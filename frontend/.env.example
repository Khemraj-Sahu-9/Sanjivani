# =============================================================
# Health Memory Agent — Frontend Environment Configuration
# =============================================================
# Copy this file to .env and fill in values.
# VITE_ prefix is required for variables exposed to the browser.
# NEVER put secrets in frontend environment variables.
# =============================================================

# Backend API base URL
# In development: http://localhost:3001
# In production: your deployed backend URL
VITE_API_BASE_URL=http://localhost:3001

# Application name (used in page titles and UI)
VITE_APP_NAME=Sanjivani

# Supabase Client Configuration (Never put secret/service-role keys here)
# VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# VITE_SUPABASE_ANON_KEY=your-legacy-anon-key-here
