# ==============================================================================
# Sanjivani (Health Memory Agent) — Frontend Production/Staging Dockerfile
# ==============================================================================
# Multi-stage build providing production bundle compilation via Vite
# and lightweight distribution via Nginx Alpine with built-in reverse proxy.
# ==============================================================================

# ---- Stage 1: Build Frontend Assets ----
FROM node:20-alpine AS builder

WORKDIR /app

# Copy root workspace manifests
COPY package*.json ./
COPY frontend/package*.json ./frontend/

# Install dependencies
RUN npm ci --workspace=frontend

# Copy frontend source files and configuration
COPY frontend/ ./frontend/

# In staging single-domain deployment, API requests route through Nginx proxy /api
ARG VITE_API_BASE_URL=""
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_APP_NAME="Sanjivani (Staging)"

# Compile static distribution
RUN npm run build --workspace=frontend

# ---- Stage 2: Serve with Nginx Alpine ----
FROM nginx:1.27-alpine AS runner

# Remove default nginx static files
RUN rm -rf /usr/share/nginx/html/*

# Copy compiled static assets from builder
COPY --from=builder /app/frontend/dist /usr/share/nginx/html

# Copy staging Nginx configuration
COPY nginx.staging.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget -qO- http://localhost/nginx-health || exit 1

CMD ["nginx", "-g", "daemon off;"]
