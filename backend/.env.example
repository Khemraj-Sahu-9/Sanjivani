# =============================================================
# Health Memory Agent — Backend Environment Configuration
# =============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# =============================================================

# ---- Application ----------------------------------------
NODE_ENV=development
PORT=3001

# ---- Demo / Scaffold Mode --------------------------------
# Set DEMO_MODE=true to skip Supabase credential validation
# and run the backend scaffold without a real Supabase account.
# All database operations will be unavailable in this mode.
DEMO_MODE=true

# ---- Supabase -------------------------------------------
# Required when DEMO_MODE=false
# Get these from: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
# Modern API Keys (sb_secret_... and sb_publishable_...)
SUPABASE_SECRET_KEY=your-secret-key-here
SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
# Legacy key fallbacks (JWT-based service_role and anon keys)
# SUPABASE_SERVICE_ROLE_KEY=your-legacy-service-role-key-here
# SUPABASE_ANON_KEY=your-legacy-anon-key-here
# SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# ---- Gemini AI / LLM Integration -------------------------
# Optional: Set your Google Gemini API key to enable live AI retrieval responses.
# If omitted or running in test mode, the application utilizes the grounded
# deterministic retrieval fallback engine without failing.
GEMINI_API_KEY=your-gemini-api-key-here

# ---- Telephony / Phase 6 Live Test Mode -------------------
# Provider selection: 'twilio' | 'exotel' | 'mock' | 'none' (default: none)
LIVE_TEST_TELEPHONY_PROVIDER=none
LIVE_TEST_MODE_ENABLED=false
LIVE_TEST_MAX_RECIPIENTS=3
LIVE_TEST_COOLDOWN_SECONDS=30
TELEPHONY_WEBHOOK_SECRET=your-webhook-secret-here

# Twilio (Required if LIVE_TEST_TELEPHONY_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your-auth-token-here
TWILIO_PHONE_NUMBER=+12025550199

# Exotel (Required if LIVE_TEST_TELEPHONY_PROVIDER=exotel)
EXOTEL_ACCOUNT_SID=your-exotel-sid-here
EXOTEL_API_KEY=your-exotel-api-key-here
EXOTEL_API_TOKEN=your-exotel-api-token-here
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_CALLER_ID=080XXXXXXXX
EXOTEL_DLT_ENTITY_ID=1101XXXXXXXXXXXX
EXOTEL_DLT_TEMPLATE_ID=1201XXXXXXXXXXXX

# ---- Phase 10: Hospital Gateway & ABDM Integration --------
# Hospital Emergency Receiving Desk
HOSPITAL_GATEWAY_URL=
HOSPITAL_GATEWAY_API_KEY=
HOSPITAL_INTEGRATION_MODE=simulated

# ABDM (Ayushman Bharat Digital Mission) Gateway
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
ABDM_GATEWAY_URL=https://dev.abdm.gov.in/gateway
ABDM_ENV=sandbox

# ---- CORS -----------------------------------------------
# The frontend origin allowed to make requests to this backend.
FRONTEND_URL=http://localhost:5173

# ---- Logging --------------------------------------------
# Options: debug | info | warn | error
LOG_LEVEL=debug
