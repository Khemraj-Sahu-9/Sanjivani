# ============================================================
# Health Memory Agent — .gitignore
# ============================================================

# ----- Environment & Secrets --------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example
*.pem
*.key
*.cert
*.p12

# ----- Dependencies -----------------------------------------
node_modules/
*/node_modules/
.pnp
.pnp.js

# ----- Build Outputs ----------------------------------------
dist/
build/
out/
.output/
frontend/dist/
backend/dist/

# ----- TypeScript -------------------------------------------
*.tsbuildinfo
tsconfig.tsbuildinfo

# ----- Logs -------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ----- Testing ----------------------------------------------
coverage/
.nyc_output/
*.lcov

# ----- OS & Editor ------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
.vscode/settings.json
*.swp
*.swo
*~

# ----- Supabase local dev -----------------------------------
supabase/.branches/
supabase/.temp/
supabase/functions/*/node_modules/

# ----- Misc -------------------------------------------------
*.local
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
